# Copy to `.env` (repo root) and fill in from your hosted Supabase project.
# `.env` is git-ignored. Never commit real values.

# Project Settings -> API (or Data API): Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings -> API Keys: the publishable / "anon" key (public, RLS-bound).
# NOT the service_role / secret key: nothing in this repo needs it.
SUPABASE_ANON_KEY=

# Connect -> Session pooler (or Direct) connection string, with your database password.
# Used by: the API server (members' queries run under RLS via SET LOCAL ROLE),
#          `npm run db:push` (migrations), and the hosted test setup.
# Example: postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# If the password contains special characters (@ : / ? # % etc.), percent-encode them (e.g. @ -> %40).
DATABASE_URL=

# API server
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
