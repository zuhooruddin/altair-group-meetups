{
  "name": "@altair/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ALTAIR meetups API: verifies Supabase sessions, validates every write with the shared Zod contract, and talks to Postgres as the member under RLS.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit --project offline",
    "test:offline": "vitest run --project unit --project offline",
    "test:hosted": "vitest run --project hosted",
    "db:reset-reference": "tsx scripts/reset-reference-meetups.ts"
  },
  "dependencies": {
    "@altair/shared": "*",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
