{
  "expo": {
    "name": "Altair Meetups",
    "slug": "altair-meetups",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8F1",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F1",
          "image": "./assets/splash-logo.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FAF8F1",
            "image": "./assets/splash-logo.png"
          }
        }
      ]
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "test.example.altair.meetups"
    },
    "android": {
      "package": "test.example.altair.meetups",
      "edgeToEdgeEnabled": true
    }
  }
}
