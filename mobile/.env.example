# Copy to mobile/.env. Expo inlines EXPO_PUBLIC_* values into the app bundle,
# so ONLY public values belong here: never the service-role key or DB password.

# Same Project URL and publishable/anon key as the root .env.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the app reaches the API server (npm run server, port 4000):
#   Android emulator:          http://10.0.2.2:4000
#   iOS simulator:             http://127.0.0.1:4000
#   Physical device / Expo Go: http://<your computer's LAN IP>:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
